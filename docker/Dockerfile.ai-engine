# ORIN AI Engine Dockerfile

FROM python:3.11.10-slim-bookworm AS builder

WORKDIR /app

RUN set -eux; \
    for attempt in 1 2 3 4 5; do \
        apt-get -o Acquire::Retries=5 update && \
        apt-get -o Acquire::Retries=5 install -y --no-install-recommends gcc && \
        break; \
        if [ "$attempt" = "5" ]; then exit 1; fi; \
        apt-get clean; \
        rm -rf /var/lib/apt/lists/*; \
        sleep $((attempt * 5)); \
    done; \
    rm -rf /var/lib/apt/lists/*

# Keep the image dependency graph identical to the reviewed Poetry lockfile.
# Installing from only pyproject.toml lets pip re-resolve the permissive ranges
# during every cold build and can produce a different runtime than CI.
COPY pyproject.toml poetry.lock ./
RUN set -eux; \
    for attempt in 1 2 3 4 5; do \
        pip install --no-cache-dir "poetry==1.8.5" && \
        POETRY_VIRTUALENVS_IN_PROJECT=true poetry install --only main --no-root --sync && \
        break; \
        if [ "$attempt" = "5" ]; then exit 1; fi; \
        rm -rf /app/.venv /root/.cache/pypoetry/cache; \
        sleep $((attempt * 10)); \
    done

COPY app ./app

FROM python:3.11.10-slim-bookworm AS runtime

WORKDIR /app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    WORKERS=1 \
    TIMEOUT=300

COPY --from=builder /app/.venv /app/.venv
COPY app ./app
COPY pyproject.toml poetry.lock ./

RUN useradd --create-home --uid 1000 appuser && \
    chown -R appuser:appuser /app

USER appuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=3).read()" || exit 1

EXPOSE 8000

CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --workers ${WORKERS} --timeout-keep-alive ${TIMEOUT}"]
