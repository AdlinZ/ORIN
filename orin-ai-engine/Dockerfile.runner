# ORIN Runner — lightweight agent for user servers (F01 接入并监控服务器)
#
# Build:
#   docker build -t orin-runner -f Dockerfile.runner .
#
# Run (enroll):
#   docker run --rm -it \\
#     -v orin-runner-cred:/root/.orin \\
#     orin-runner enroll --name my-runner --token sk-enroll-... --url https://orin.example.com
#
# Run (resume with saved credentials):
#   docker run --rm -d \\
#     -v orin-runner-cred:/root/.orin \\
#     orin-runner resume

FROM python:3.11-slim

LABEL org.orin.runner="true"
LABEL description="ORIN Runner — connect your server to the ORIN Control Plane"

# Install system deps for psutil
RUN apt-get update && apt-get install -y --no-install-recommends \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Slow or rate-limited package mirrors should not turn a transient read timeout
# into a non-reproducible Runner image failure.
ENV PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=8

# A Runner executes through TaskRuntime, so the image must carry the same execution
# kernel and a lock-derived dependency set.  Installing the Poetry project directly
# made container builds resolve the whole graph again and require poetry-core at
# build time; this exported file keeps the image reproducible and avoids that second
# resolver.
COPY requirements.runner.txt ./
RUN pip install --no-cache-dir -r requirements.runner.txt
COPY app/ ./app/

# The credential volume
VOLUME /root/.orin

ENTRYPOINT ["python", "-m", "app.runner"]
CMD ["resume"]
