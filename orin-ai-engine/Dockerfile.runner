# ORIN Runner — lightweight agent for user servers (F01 接入并监控服务器)
#
# Build:
#   docker build -t orin-runner -f Dockerfile.runner .
#
# Run (enroll):
#   docker run --rm -it \\
#     -v orin-runner-cred:/root/.orin \\
#     orin-runner enroll --name my-runner --token sk-enroll-... --url https://orin.example.com
#
# Run (resume with saved credentials):
#   docker run --rm -d \\
#     -v orin-runner-cred:/root/.orin \\
#     orin-runner resume

FROM python:3.11-slim

LABEL org.orin.runner="true"
LABEL description="ORIN Runner — connect your server to the ORIN Control Plane"

# Install system deps for psutil
RUN apt-get update && apt-get install -y --no-install-recommends \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only what the Runner needs (no AI Engine server/runtime dependencies)
COPY app/runner/ ./app/runner/
COPY app/core/w3c_trace.py ./app/core/w3c_trace.py

# Install only Runner dependencies. The image invokes the existing module directly,
# so it does not pull the complete AI Engine dependency graph.
RUN pip install --no-cache-dir httpx psutil

# The credential volume
VOLUME /root/.orin

ENTRYPOINT ["python", "-m", "app.runner"]
CMD ["resume"]
